# Copy this file to .env and fill in your own values before running any script.
# S3 bucket names must be globally unique across all of AWS accounts, so pick
# names that aren't already taken (e.g. suffix with a short throwaway token).

AWS_PROFILE=your-aws-profile-name
AWS_REGION=your-region-name
GENERAL_BUCKET_NAME=your-unique-lakehouse-bucket
S3TABLES_BUCKET_NAME=your-unique-managed-bucket
OPS_BUCKET_NAME=your-unique-ops-bucket
GLUE_DATABASE=iceberg_maint_eval
GLUE_OPTIMIZER_ROLE_NAME=iceberg-maint-eval-glue-optimizer
PROJECT_TAG=iceberg-maint-eval
PAIRS=BTC-USD,ETH-USD
